{
  "name": "limxdesk",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "tauri": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location -LiteralPath backend; ..\\node_modules\\.bin\\tauri\"",
    "tauri:dev": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location -LiteralPath backend; ..\\node_modules\\.bin\\tauri dev\"",
    "tauri:build": "powershell -NoProfile -ExecutionPolicy Bypass -Command \"Set-Location -LiteralPath backend; ..\\node_modules\\.bin\\tauri build\""
  },
  "dependencies": {
    "@limxdesk/shell": "workspace:*",
    "@limxdesk/notifications": "workspace:*",
    "@limxdesk/naming": "workspace:*",
    "@limxdesk/ui": "workspace:*",
    "@limxdesk/console": "workspace:*",
    "@limxdesk/settings": "workspace:*",
    "@tauri-apps/api": "^2.11.0",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@tauri-apps/plugin-dialog": "^2.7.1",
    "@tauri-apps/plugin-fs": "^2.5.1",
    "lucide-react": "^1.14.0",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.0",
    "@tauri-apps/cli": "^2.11.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6.0.1",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vite": "^8.0.12"
  }
}
